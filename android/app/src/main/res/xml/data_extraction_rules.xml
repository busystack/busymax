<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <!-- Application support (including busymax.sqlite and its sidecars). -->
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="flutter_secure_storage" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <!-- Application support (including busymax.sqlite and its sidecars). -->
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="flutter_secure_storage" />
    </device-transfer>
</data-extraction-rules>
